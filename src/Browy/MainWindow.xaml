<Window x:Class="Browy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Browy"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="Browy"
        Height="800" Width="1200"
        MinHeight="500" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Foreground="{StaticResource TextPrimaryBrush}"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        WindowStyle="None">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1"
                      CaptionHeight="42"
                      CornerRadius="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- Main Container overlaying the Windows 11 DWM Acrylic Backdrop -->
    <Grid Background="#140A0A0E">
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar (Tabs & Spaces) - Auto-sized for smooth width animation -->
            <ColumnDefinition x:Name="SidebarColumn" Width="Auto"/>
            <!-- Main Content Area -->
            <ColumnDefinition Width="*"/>
            <!-- Right Sidebar (Agents Panel) - Auto-sized for smooth width animation -->
            <ColumnDefinition x:Name="AgentsColumn" Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT SIDEBAR (VERTICAL TABS) ==================== -->
        <Border x:Name="SidebarBorder"
                Grid.Column="0"
                Width="240"
                ClipToBounds="True"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Top Window Controls & New Tab (Height 42) -->
                    <RowDefinition Height="42"/>
                    <!-- Vertical Tab List -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Sidebar Header: Toggle Sidebar, App Brand, & New Tab Button -->
                <Grid Grid.Row="0"
                      Margin="10,0,10,0"
                      VerticalAlignment="Center"
                      Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Toggle Sidebar Button -->
                    <Button Grid.Column="0"
                            Style="{StaticResource IconButton}"
                            ToolTip="Collapse Sidebar (Ctrl+S)"
                            Click="ToggleSidebar_Click"
                            Width="28" Height="28"
                            Margin="0,0,6,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE8A0;" FontSize="12" Foreground="#FFFFFF"/>
                    </Button>

                    <!-- App Brand (Draggable space) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE774;" FontSize="13" Margin="0,0,6,0" Foreground="#FFFFFF"/>
                        <TextBlock Text="BROWY"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- New Tab Button -->
                    <Button Grid.Column="2"
                            Style="{StaticResource IconButton}"
                            ToolTip="New Tab (Ctrl+T)"
                            Click="NewTabButton_Click"
                            Width="28" Height="28"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE710;" FontSize="12" Foreground="#FFFFFF"/>
                    </Button>
                </Grid>

                <!-- Vertical Tab List (Arc / Zen Style) -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="6,4,6,6"
                              WindowChrome.IsHitTestVisibleInChrome="True">
                    <ItemsControl x:Name="TabsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="TabBorder"
                                        CornerRadius="8"
                                        Margin="0,2,0,2"
                                        Background="Transparent"
                                        BorderThickness="1"
                                        BorderBrush="Transparent"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="TabItem_MouseLeftButtonDown">
                                    <Grid>
                                        <!-- Snappy Animated Active Highlight Layer -->
                                        <Border x:Name="ActiveHighlight"
                                                CornerRadius="8"
                                                Background="#1CFFFFFF"
                                                BorderBrush="#25FFFFFF"
                                                BorderThickness="1"
                                                Opacity="0"/>

                                        <Grid Margin="10,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="22"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Fetched Real Favicon or Monochrome Fallback Icon -->
                                            <Grid Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="&#xE774;"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           Foreground="#FFFFFF">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource FluentIcon}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasFaviconImage}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Image Source="{Binding FaviconImage}"
                                                       Width="16" Height="16"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasFaviconImage}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                            </Grid>

                                            <!-- Tab Title -->
                                            <TextBlock x:Name="TabTitleText"
                                                       Grid.Column="1"
                                                       Text="{Binding Title}"
                                                       FontSize="12"
                                                       FontWeight="Normal"
                                                       Foreground="#FFFFFF"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       Margin="6,0,4,0"/>

                                            <!-- Close Tab Button -->
                                            <Button Grid.Column="2"
                                                    x:Name="CloseTabBtn"
                                                    Style="{StaticResource IconButton}"
                                                    Padding="2"
                                                    Width="20" Height="20"
                                                    Click="CloseTab_Click"
                                                    Tag="{Binding}"
                                                    ToolTip="Close Tab (Ctrl+W)">
                                                <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE711;" FontSize="9" Foreground="#CCFFFFFF"/>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="#10FFFFFF"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ActiveHighlight"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="1" Duration="0:0:0.14">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ActiveHighlight"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="0" Duration="0:0:0.10"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                        <Setter TargetName="TabTitleText" Property="Foreground" Value="#FFFFFF"/>
                                        <Setter TargetName="TabTitleText" Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Left Sidebar Resize Splitter (Right Edge) -->
                <Border x:Name="LeftSidebarSplitter"
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Width="7"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Cursor="SizeWE"
                        Background="Transparent"
                        Panel.ZIndex="100"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        PreviewMouseLeftButtonDown="LeftSidebarSplitter_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="LeftSidebarSplitter_PreviewMouseMove"
                        PreviewMouseLeftButtonUp="LeftSidebarSplitter_PreviewMouseLeftButtonUp"
                        LostMouseCapture="Splitter_LostMouseCapture">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#30FFFFFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== MAIN CONTENT AREA ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Row 0: Top Horizontal Tabs Strip (Visible when Sidebar is Collapsed - Screenshot 1) -->
                <RowDefinition x:Name="HorizontalTabsRowDef" Height="Auto"/>
                <!-- Row 1: Nav & Omnibox Header (Height 42) -->
                <RowDefinition Height="42"/>
                <!-- Row 2: Bookmarks / Quick Pins Bar -->
                <RowDefinition Height="Auto"/>
                <!-- Row 3: Floating Web View Canvas Card -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ROW 0: Horizontal Tabs Bar (Displayed when Sidebar is Collapsed, matching Screenshot 1) -->
            <Grid x:Name="HorizontalTabsRow"
                  Grid.Row="0"
                  Height="38"
                  Visibility="Collapsed"
                  Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <!-- Sidebar Toggle Button to Uncollapse -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Horizontal Tabs Strip -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar Restore Button -->
                <Button Grid.Column="0"
                        Style="{StaticResource IconButton}"
                        ToolTip="Expand Sidebar (Ctrl+S)"
                        Click="ToggleSidebar_Click"
                        Width="28" Height="28"
                        Margin="8,0,4,0"
                        VerticalAlignment="Center"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE8A0;" FontSize="12" Foreground="#FFFFFF"/>
                </Button>

                <!-- Horizontal Tabs ScrollViewer (Reserved 140px margin on right for caption buttons) -->
                <ScrollViewer x:Name="HorizontalTabsScrollViewer"
                              Grid.Column="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Margin="0,0,140,0"
                              VerticalAlignment="Center"
                              PreviewMouseWheel="HorizontalTabsScrollViewer_PreviewMouseWheel"
                              PreviewMouseLeftButtonDown="HorizontalTabsScrollViewer_PreviewMouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ItemsControl x:Name="HorizontalTabsItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="HorizTabBorder"
                                            CornerRadius="7"
                                            Margin="0,0,4,0"
                                            Background="Transparent"
                                            BorderThickness="1"
                                            BorderBrush="Transparent"
                                            Cursor="Hand"
                                            WindowChrome.IsHitTestVisibleInChrome="True"
                                            MouseLeftButtonDown="TabItem_MouseLeftButtonDown">
                                        <Grid>
                                            <!-- Snappy Animated Active Highlight Layer -->
                                            <Border x:Name="ActiveHighlight"
                                                    CornerRadius="7"
                                                    Background="#1EFFFFFF"
                                                    BorderBrush="#25FFFFFF"
                                                    BorderThickness="1"
                                                    Opacity="0"/>

                                            <Grid Margin="8,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Favicon / Tab Icon -->
                                                <Grid Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock Text="&#xE774;"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               Foreground="#FFFFFF">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource FluentIcon}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasFaviconImage}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Image Source="{Binding FaviconImage}"
                                                           Width="16" Height="16"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasFaviconImage}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                </Grid>

                                                <!-- Tab Title -->
                                                <TextBlock x:Name="HorizTitleText"
                                                           Grid.Column="1"
                                                           Text="{Binding Title}"
                                                           FontSize="11.5"
                                                           Foreground="#FFFFFF"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="130"
                                                           VerticalAlignment="Center"
                                                           Margin="6,0,4,0"/>

                                                <!-- Close Button -->
                                                <Button Grid.Column="2"
                                                        Style="{StaticResource IconButton}"
                                                        Padding="2"
                                                        Width="18" Height="18"
                                                        Click="CloseTab_Click"
                                                        Tag="{Binding}"
                                                        ToolTip="Close Tab">
                                                    <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE711;" FontSize="8" Foreground="#CCFFFFFF"/>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="HorizTabBorder" Property="Background" Value="#10FFFFFF"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ActiveHighlight"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="1" Duration="0:0:0.14">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ActiveHighlight"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0" Duration="0:0:0.10"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                            <Setter TargetName="HorizTitleText" Property="Foreground" Value="#FFFFFF"/>
                                            <Setter TargetName="HorizTitleText" Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Add New Tab Button in horizontal strip -->
                        <Button Style="{StaticResource IconButton}"
                                ToolTip="New Tab (Ctrl+T)"
                                Click="NewTabButton_Click"
                                Width="26" Height="26"
                                Margin="2,0,0,0"
                                VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE710;" FontSize="11" Foreground="#FFFFFF"/>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ROW 1: Navigation Controls & Omnibox Header -->
            <Grid x:Name="TopNavRow" Grid.Row="1" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid x:Name="TopNavMargin" Margin="10,0,140,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <!-- Nav Controls (Back, Forward, Refresh) -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Omnibox URL Input -->
                        <ColumnDefinition Width="*"/>
                        <!-- Tools Controls (DevTools, History) -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Navigation Controls: Back, Forward, Refresh (Rounded Chevrons & Monochrome Icons) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,8,0">
                        <!-- Back Button (Smooth Rounded ChevronLeft) -->
                        <Button x:Name="BackButton"
                                Style="{StaticResource IconButton}"
                                ToolTip="Back (Alt+Left)"
                                Click="BackButton_Click"
                                Width="28" Height="28"
                                Margin="0,0,2,0">
                            <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE76B;" FontSize="11" Foreground="#FFFFFF"/>
                        </Button>

                        <!-- Forward Button (Smooth Rounded ChevronRight) -->
                        <Button x:Name="ForwardButton"
                                Style="{StaticResource IconButton}"
                                ToolTip="Forward (Alt+Right)"
                                Click="ForwardButton_Click"
                                Width="28" Height="28"
                                Margin="0,0,2,0">
                            <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE76C;" FontSize="11" Foreground="#FFFFFF"/>
                        </Button>

                        <!-- Reload / Stop Button -->
                        <Button x:Name="ReloadButton"
                                Style="{StaticResource IconButton}"
                                ToolTip="Reload (Ctrl+R / F5)"
                                Click="ReloadButton_Click"
                                Width="28" Height="28">
                            <TextBlock x:Name="ReloadIconText" Style="{StaticResource FluentIcon}" Text="&#xE72C;" FontSize="11" Foreground="#FFFFFF"/>
                        </Button>
                    </StackPanel>

                    <!-- Omnibox (Address & Search Bar) with Low-Alpha Background over Acrylic -->
                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="4,0,8,0">
                        <Border x:Name="OmniboxBorder"
                                Background="#10FFFFFF"
                                BorderBrush="#18FFFFFF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Height="32"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- Security Lock Icon Button -->
                                    <ColumnDefinition Width="30"/>
                                    <!-- URL TextBox -->
                                    <ColumnDefinition Width="*"/>
                                    <!-- Page Zoom Level Indicator -->
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- Bookmark Star -->
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>

                                <!-- Monochrome SSL Security Indicator Button -->
                                <Button x:Name="SecurityButton"
                                        Grid.Column="0"
                                        Style="{StaticResource IconButton}"
                                        ToolTip="View site information"
                                        Click="SecurityButton_Click"
                                        Width="26" Height="26">
                                    <TextBlock x:Name="SecurityIconText"
                                               Style="{StaticResource FluentIcon}"
                                               Text="&#xE72E;"
                                               FontSize="11"
                                               Foreground="#FFFFFF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Button>

                                <!-- URL Input TextBox -->
                                <TextBox x:Name="UrlTextBox"
                                         Grid.Column="1"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         CaretBrush="#FFFFFF"
                                         FontSize="12.5"
                                         VerticalAlignment="Center"
                                         TextChanged="UrlTextBox_TextChanged"
                                         KeyDown="UrlTextBox_KeyDown"
                                         PreviewKeyDown="UrlTextBox_PreviewKeyDown"
                                         GotFocus="UrlTextBox_GotFocus"/>

                                <!-- Placeholder Text -->
                                <TextBlock x:Name="UrlPlaceholderText"
                                           Grid.Column="1"
                                           Text="Search or type a URL..."
                                           Foreground="#40FFFFFF"
                                           FontSize="12.5"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"/>

                                <!-- Page Zoom Level Indicator Pill -->
                                <Button x:Name="ZoomIndicatorButton"
                                        Grid.Column="2"
                                        Style="{StaticResource IconButton}"
                                        ToolTip="Page Zoom Level"
                                        Click="ZoomIndicatorButton_Click"
                                        Height="22"
                                        Padding="5,0"
                                        Margin="0,0,4,0"
                                        Visibility="Collapsed">
                                    <Border Background="#20FFFFFF" CornerRadius="4" Padding="5,1">
                                        <TextBlock x:Name="ZoomIndicatorText"
                                                   Text="100%"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFFFFF"/>
                                    </Border>
                                </Button>

                                <!-- Monochrome Bookmark Star Button -->
                                <Button Grid.Column="3"
                                        Style="{StaticResource IconButton}"
                                        ToolTip="Bookmark this page (Ctrl+D)"
                                        Click="BookmarkCurrentPage_Click"
                                        Width="26" Height="26">
                                    <TextBlock x:Name="BookmarkStarIcon" Style="{StaticResource FluentIcon}" Text="&#xE734;" FontSize="11" Foreground="#FFFFFF"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Omnibox Autocomplete & Suggestions Popup -->
                        <Popup x:Name="OmniboxSuggestionsPopup"
                               PlacementTarget="{Binding ElementName=OmniboxBorder}"
                               Placement="Bottom"
                               VerticalOffset="4"
                               Width="{Binding ActualWidth, ElementName=OmniboxBorder}"
                               AllowsTransparency="True"
                               StaysOpen="False"
                               PopupAnimation="Fade">
                            <Border MaxHeight="320"
                                    Background="#F414141A"
                                    BorderBrush="{StaticResource GlassBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="6,4">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.75"/>
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ListBox x:Name="OmniboxSuggestionsListBox"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             SelectionMode="Single"
                                             PreviewMouseLeftButtonUp="OmniboxSuggestionsListBox_PreviewMouseLeftButtonUp"
                                             MouseDoubleClick="OmniboxSuggestionsListBox_MouseDoubleClick"
                                             PreviewKeyDown="OmniboxSuggestionsListBox_PreviewKeyDown">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,1"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="ItemBorder"
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderBrush="Transparent"
                                                                    BorderThickness="1"
                                                                    CornerRadius="6"
                                                                    Padding="8,6"
                                                                    Margin="2,1">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#18FFFFFF"/>
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#2AFFFFFF"/>
                                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#40FFFFFF"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Style="{StaticResource FluentIcon}"
                                                               Text="{Binding IconGlyph}"
                                                               FontSize="11"
                                                               Foreground="#94A3B8"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Center"/>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,8,0">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#FFFFFF"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Url}"
                                                                   FontSize="9.5"
                                                                   Foreground="#94A3B8"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,1,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasUrl}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <Border Grid.Column="2"
                                                            Background="#15FFFFFF"
                                                            CornerRadius="4"
                                                            Padding="5,1"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TypeBadge}"
                                                                   FontSize="8.5"
                                                                   Foreground="#CBD5E1"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Tool Buttons (History, Downloads, Command Palette) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- History Button -->
                        <Button x:Name="HistoryButton"
                                Style="{StaticResource IconButton}"
                                ToolTip="History (Ctrl+H)"
                                Click="HistoryButton_Click"
                                Width="28" Height="28"
                                Margin="0,0,3,0">
                            <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE81C;" FontSize="12" Foreground="#FFFFFF"/>
                        </Button>

                        <!-- Downloads Button -->
                        <Button x:Name="DownloadsButton"
                                Style="{StaticResource IconButton}"
                                ToolTip="Downloads (Ctrl+Shift+J)"
                                Click="DownloadsButton_Click"
                                Width="28" Height="28"
                                Margin="0,0,3,0">
                            <Grid>
                                <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE896;" FontSize="12" Foreground="#FFFFFF"/>
                                <Border x:Name="DownloadsBadge"
                                        Background="#3B82F6"
                                        CornerRadius="5"
                                        Padding="3,0"
                                        Margin="10,-6,-6,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="DownloadsBadgeText"
                                               Text="1"
                                               FontSize="8"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF"/>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Command Palette & Options (Ellipsis Button) -->
                        <Button x:Name="CommandPaletteButton"
                                Style="{StaticResource IconButton}"
                                ToolTip="Command Palette &amp; Options (Ctrl+K / Ctrl+Shift+P)"
                                Click="CommandPaletteButton_Click"
                                Width="28" Height="28">
                            <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE712;" FontSize="12" Foreground="#FFFFFF"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ROW 2: Favorites / Bookmarks Bar (Matching Screenshot 2 - Low Alpha Unified Styling) -->
            <Border x:Name="BookmarksBar"
                    Grid.Row="2"
                    Margin="10,2,12,6"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                <ScrollViewer x:Name="BookmarksScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="BookmarksScrollViewer_PreviewMouseWheel">
                    <ItemsControl x:Name="BookmarksItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource IconButton}"
                                        Click="BookmarkItem_Click"
                                        Tag="{Binding Url}"
                                        Margin="0,0,5,0"
                                        Padding="0"
                                        ToolTip="{Binding Url}">
                                    <Button.ContextMenu>
                                        <ContextMenu Background="#202024" BorderBrush="#25FFFFFF" BorderThickness="1">
                                            <MenuItem Header="Open in New Tab" Click="OpenBookmarkInNewTab_Click" Foreground="#FFFFFF"/>
                                            <MenuItem Header="Copy Link Address" Click="CopyBookmarkUrl_Click" Foreground="#FFFFFF"/>
                                            <Separator Background="#25FFFFFF"/>
                                            <MenuItem Header="Delete Bookmark" Click="DeleteBookmark_Click" Foreground="#EF4444"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Border Background="#10FFFFFF"
                                            BorderBrush="#14FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="7,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Real Fetched Favicon (16x16) or Monochrome Fallback -->
                                            <Grid Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE774;"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           Foreground="#FFFFFF">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource FluentIcon}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Favicon}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Image Source="{Binding Favicon}"
                                                       Width="16" Height="16"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Favicon}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                            </Grid>
                                            <!-- Bookmark Title -->
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="11.5"
                                                       Foreground="#FFFFFF"
                                                       FontWeight="Normal"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- ROW 3: Floating Web Content Canvas (Matching Reference Screenshot Rounded Card) -->
            <Border Grid.Row="3"
                    Margin="10,2,14,14"
                    CornerRadius="14"
                    BorderThickness="1"
                    BorderBrush="#25FFFFFF"
                    Background="{StaticResource CardBgBrush}"
                    ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.55"/>
                </Border.Effect>
                <Grid>
                    <!-- Loading Progress Bar (Subtle Monochrome Minimal Bar) -->
                    <ProgressBar x:Name="PageProgressBar"
                                 Height="2"
                                 VerticalAlignment="Top"
                                 HorizontalAlignment="Stretch"
                                 Background="Transparent"
                                 Foreground="#50FFFFFF"
                                 BorderThickness="0"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed"
                                 Panel.ZIndex="10"/>

                    <!-- Web Content Host Container -->
                    <Grid x:Name="WebContentGrid" SizeChanged="WebContentGrid_SizeChanged">
                        <!-- WebView2 controls hosted here -->
                    </Grid>

                    <!-- Speed Dial / Start Page Overlay when no active tab -->
                    <Grid x:Name="StartPageGrid" Visibility="Collapsed" Background="#141418">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Browy"
                                       FontSize="38"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="#E2E8F0"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="Search or jump to a site"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       Foreground="#CBD5E1"
                                       Margin="0,0,0,26"/>

                            <!-- Quick Action Tiles with fetched favicons -->
                            <WrapPanel HorizontalAlignment="Center" MaxWidth="500">
                                <Button Style="{StaticResource IconButton}" Click="SpeedDial_Click" Tag="https://github.com" Margin="6">
                                    <Border Background="#12FFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="8" Padding="14,10" Width="100">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Image Source="https://www.google.com/s2/favicons?domain=github.com&amp;sz=64" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center"/>
                                            <TextBlock Text="GitHub" FontSize="11" Foreground="#FFF" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Click="SpeedDial_Click" Tag="https://developer.mozilla.org" Margin="6">
                                    <Border Background="#12FFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="8" Padding="14,10" Width="100">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Image Source="https://www.google.com/s2/favicons?domain=developer.mozilla.org&amp;sz=64" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center"/>
                                            <TextBlock Text="MDN Docs" FontSize="11" Foreground="#FFF" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Click="SpeedDial_Click" Tag="https://youtube.com" Margin="6">
                                    <Border Background="#12FFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="8" Padding="14,10" Width="100">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Image Source="https://www.google.com/s2/favicons?domain=youtube.com&amp;sz=64" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center"/>
                                            <TextBlock Text="YouTube" FontSize="11" Foreground="#FFF" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Click="SpeedDial_Click" Tag="https://x.com" Margin="6">
                                    <Border Background="#12FFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="8" Padding="14,10" Width="100">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Image Source="https://www.google.com/s2/favicons?domain=x.com&amp;sz=64" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center"/>
                                            <TextBlock Text="X / Web" FontSize="11" Foreground="#FFF" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- History Popup (Floating Win32 topmost window over WebView2 HWND - Fixes Airspace bug!) -->
            <Popup x:Name="HistoryPopup"
                   PlacementTarget="{Binding ElementName=HistoryButton}"
                   Placement="Bottom"
                   HorizontalOffset="-260"
                   VerticalOffset="8"
                   AllowsTransparency="True"
                   StaysOpen="False"
                   PopupAnimation="Fade">
                <Border Width="320"
                        MaxHeight="460"
                        Background="#F414141A"
                        BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.75"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Header -->
                            <RowDefinition Height="Auto"/>
                            <!-- Empty message -->
                            <RowDefinition Height="Auto"/>
                            <!-- History List -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- History Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE81C;" FontSize="13" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                                <TextBlock Text="History" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <!-- Clear History -->
                            <Button Grid.Column="1"
                                    Style="{StaticResource IconButton}"
                                    ToolTip="Clear History"
                                    Click="ClearHistory_Click"
                                    Margin="0,0,4,0"
                                    Width="26" Height="26">
                                <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE74D;" FontSize="11" Foreground="#FFFFFF"/>
                            </Button>

                            <!-- Close Panel -->
                            <Button Grid.Column="2"
                                    Style="{StaticResource IconButton}"
                                    ToolTip="Close History"
                                    Click="CloseHistory_Click"
                                    Width="26" Height="26">
                                <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE711;" FontSize="10" Foreground="#FFFFFF"/>
                            </Button>
                        </Grid>

                        <!-- Empty State Text -->
                        <TextBlock x:Name="HistoryEmptyText"
                                   Grid.Row="1"
                                   Text="No browsing history yet"
                                   FontSize="12"
                                   Foreground="#E2E8F0"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,0"
                                   Visibility="Collapsed"/>

                        <!-- History List -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="HistoryItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource IconButton}"
                                                Click="HistoryItem_Click"
                                                Tag="{Binding Url}"
                                                HorizontalContentAlignment="Stretch"
                                                Margin="0,0,0,4"
                                                Padding="8,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Fetched Favicon -->
                                                <Grid Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE774;"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               Foreground="#FFFFFF">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource FluentIcon}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Favicon}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Image Source="{Binding Favicon}"
                                                           Width="16" Height="16"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Favicon}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                </Grid>

                                                <!-- Title & URL -->
                                                <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="11.5"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Url}"
                                                               FontSize="9.5"
                                                               Foreground="#CBD5E1"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,1,0,0"/>
                                                </StackPanel>

                                                <!-- Timestamp -->
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding FormattedTime}"
                                                           FontSize="10"
                                                           Foreground="#70FFFFFF"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Popup>

            <!-- Downloads Popup (Floating Win32 topmost window over WebView2 HWND) -->
            <Popup x:Name="DownloadsPopup"
                   PlacementTarget="{Binding ElementName=DownloadsButton}"
                   Placement="Bottom"
                   HorizontalOffset="-280"
                   VerticalOffset="8"
                   AllowsTransparency="True"
                   StaysOpen="False"
                   PopupAnimation="Fade">
                <Border Width="340"
                        MaxHeight="460"
                        Background="#F414141A"
                        BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.75"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Header -->
                            <RowDefinition Height="Auto"/>
                            <!-- Empty message -->
                            <RowDefinition Height="Auto"/>
                            <!-- Downloads List -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE896;" FontSize="13" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                                <TextBlock Text="Downloads" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <!-- Open Downloads Folder -->
                            <Button Grid.Column="1"
                                    Style="{StaticResource IconButton}"
                                    ToolTip="Open Downloads Folder"
                                    Click="OpenDownloadsFolder_Click"
                                    Margin="0,0,4,0"
                                    Width="26" Height="26">
                                <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE838;" FontSize="11" Foreground="#FFFFFF"/>
                            </Button>

                            <!-- Clear Completed Downloads -->
                            <Button Grid.Column="2"
                                    Style="{StaticResource IconButton}"
                                    ToolTip="Clear Completed Downloads"
                                    Click="ClearDownloads_Click"
                                    Margin="0,0,4,0"
                                    Width="26" Height="26">
                                <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE74D;" FontSize="11" Foreground="#FFFFFF"/>
                            </Button>

                            <!-- Close Panel -->
                            <Button Grid.Column="3"
                                    Style="{StaticResource IconButton}"
                                    ToolTip="Close"
                                    Click="CloseDownloads_Click"
                                    Width="26" Height="26">
                                <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE711;" FontSize="10" Foreground="#FFFFFF"/>
                            </Button>
                        </Grid>

                        <!-- Empty State Text -->
                        <TextBlock x:Name="DownloadsEmptyText"
                                   Grid.Row="1"
                                   Text="No downloads yet"
                                   FontSize="12"
                                   Foreground="#E2E8F0"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,0"
                                   Visibility="Collapsed"/>

                        <!-- Downloads List -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="DownloadsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#10FFFFFF"
                                                BorderBrush="#15FFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Margin="0,0,0,6"
                                                Padding="10,8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Main Row: Icon + Name + Action Buttons -->
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- File Type Icon -->
                                                    <Border Grid.Column="0"
                                                            Width="22" Height="22"
                                                            Background="#18FFFFFF"
                                                            CornerRadius="5"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Left">
                                                        <TextBlock Style="{StaticResource FluentIcon}"
                                                                   Text="{Binding IconGlyph}"
                                                                   FontSize="11"
                                                                   Foreground="#FFFFFF"/>
                                                    </Border>

                                                    <!-- File Name and Status -->
                                                    <StackPanel Grid.Column="1" Margin="6,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileName}"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#FFFFFF"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding ResultFilePath}"/>
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   FontSize="9.5"
                                                                   Foreground="#94A3B8"
                                                                   Margin="0,2,0,0"/>
                                                    </StackPanel>

                                                    <!-- Action Buttons -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- Open File (if completed) -->
                                                        <Button ToolTip="Open File"
                                                                Click="OpenFileDownload_Click"
                                                                Tag="{Binding}"
                                                                Width="24" Height="24"
                                                                Margin="0,0,2,0">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE8E5;" FontSize="10" Foreground="#FFFFFF"/>
                                                        </Button>

                                                        <!-- Show in Folder (if completed) -->
                                                        <Button ToolTip="Show in folder"
                                                                Click="OpenFolderDownload_Click"
                                                                Tag="{Binding}"
                                                                Width="24" Height="24"
                                                                Margin="0,0,2,0">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE838;" FontSize="10" Foreground="#FFFFFF"/>
                                                        </Button>

                                                        <!-- Cancel (if in progress) -->
                                                        <Button ToolTip="Cancel Download"
                                                                Click="CancelDownload_Click"
                                                                Tag="{Binding}"
                                                                Width="24" Height="24">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsInProgress}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE711;" FontSize="9" Foreground="#EF4444"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Progress Bar (shown when InProgress) -->
                                                <ProgressBar Grid.Row="1"
                                                             Height="3"
                                                             Margin="0,6,0,0"
                                                             Value="{Binding PercentComplete}"
                                                             Maximum="100"
                                                             Foreground="#3B82F6"
                                                             Background="#20FFFFFF"
                                                             BorderThickness="0">
                                                    <ProgressBar.Style>
                                                        <Style TargetType="ProgressBar">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsInProgress}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ProgressBar.Style>
                                                </ProgressBar>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Popup>

            <!-- Find in Page Floating Bar (Top-Right over WebContentGrid) -->
            <Popup x:Name="FindPopup"
                   PlacementTarget="{Binding ElementName=WebContentGrid}"
                   Placement="Custom"
                   AllowsTransparency="True"
                   StaysOpen="True"
                   PopupAnimation="Fade">
                <Border Width="330"
                        Height="38"
                        Background="#F418181E"
                        BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="6,3"
                        SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.7"/>
                    </Border.Effect>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <!-- Search Icon -->
                            <ColumnDefinition Width="20"/>
                            <!-- Input Box -->
                            <ColumnDefinition Width="*"/>
                            <!-- Match Count -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Prev Match -->
                            <ColumnDefinition Width="24"/>
                            <!-- Next Match -->
                            <ColumnDefinition Width="24"/>
                            <!-- Match Case -->
                            <ColumnDefinition Width="26"/>
                            <!-- Close -->
                            <ColumnDefinition Width="24"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Icon -->
                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource FluentIcon}"
                                   Text="&#xE721;"
                                   FontSize="11"
                                   Foreground="#90FFFFFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <!-- Search TextBox -->
                        <TextBox x:Name="FindTextBox"
                                 Grid.Column="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#FFFFFF"
                                 CaretBrush="#FFFFFF"
                                 FontSize="12"
                                 VerticalAlignment="Center"
                                 Margin="4,0,4,0"
                                 TextChanged="FindTextBox_TextChanged"
                                 KeyDown="FindTextBox_KeyDown"/>

                        <!-- Match Count Display -->
                        <TextBlock x:Name="FindMatchCountText"
                                   Grid.Column="2"
                                   Text=""
                                   FontSize="10.5"
                                   Foreground="#94A3B8"
                                   VerticalAlignment="Center"
                                   Margin="2,0,6,0"/>

                        <!-- Previous Match Button -->
                        <Button Grid.Column="3"
                                Style="{StaticResource IconButton}"
                                ToolTip="Previous match (Shift+Enter)"
                                Click="FindPrevious_Click"
                                Width="22" Height="22">
                            <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE70E;" FontSize="9" Foreground="#FFFFFF"/>
                        </Button>

                        <!-- Next Match Button -->
                        <Button Grid.Column="4"
                                Style="{StaticResource IconButton}"
                                ToolTip="Next match (Enter)"
                                Click="FindNext_Click"
                                Width="22" Height="22">
                            <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE70D;" FontSize="9" Foreground="#FFFFFF"/>
                        </Button>

                        <!-- Match Case Toggle -->
                        <Button x:Name="FindMatchCaseButton"
                                Grid.Column="5"
                                Style="{StaticResource IconButton}"
                                ToolTip="Match Case"
                                Click="FindMatchCase_Click"
                                Width="24" Height="22">
                            <TextBlock x:Name="FindMatchCaseText"
                                       Text="Aa"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="#80FFFFFF"/>
                        </Button>

                        <!-- Close Button -->
                        <Button Grid.Column="6"
                                Style="{StaticResource IconButton}"
                                ToolTip="Close (Escape)"
                                Click="FindClose_Click"
                                Width="22" Height="22">
                            <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE711;" FontSize="9" Foreground="#FFFFFF"/>
                        </Button>
                    </Grid>
                </Border>
            </Popup>

            <!-- Site Security & Permissions Popup -->
            <Popup x:Name="SecurityPopup"
                   PlacementTarget="{Binding ElementName=SecurityButton}"
                   Placement="Bottom"
                   HorizontalOffset="-10"
                   VerticalOffset="8"
                   AllowsTransparency="True"
                   StaysOpen="False"
                   PopupAnimation="Fade">
                <Border Width="300"
                        Background="#F414141A"
                        BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.75"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Connection status header -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="22" Height="22"
                                    Background="#1510B981"
                                    CornerRadius="6"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="SecurityDialogIcon"
                                           Style="{StaticResource FluentIcon}"
                                           Text="&#xE72E;"
                                           FontSize="11"
                                           Foreground="#10B981"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="SecurityStatusTitle"
                                           Text="Connection is secure"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF"/>
                                <TextBlock x:Name="SecurityStatusDomain"
                                           Text="example.com"
                                           FontSize="9.5"
                                           Foreground="#94A3B8"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="#18FFFFFF" Margin="0,0,0,10"/>

                        <!-- Certificate info -->
                        <TextBlock Text="CERTIFICATE INFORMATION" FontSize="8.5" FontWeight="SemiBold" Foreground="#60FFFFFF" Margin="0,0,0,4"/>
                        <TextBlock x:Name="SecurityCertText"
                                   Text="Valid SSL Certificate (HTTPS encryption active)"
                                   FontSize="10"
                                   Foreground="#CBD5E1"
                                   Margin="0,0,0,10"/>

                        <Border Height="1" Background="#18FFFFFF" Margin="0,0,0,10"/>

                        <!-- Permissions summary -->
                        <TextBlock Text="SITE PERMISSIONS" FontSize="8.5" FontWeight="SemiBold" Foreground="#60FFFFFF" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE714;" FontSize="10" Foreground="#CBD5E1" Margin="0,0,6,0"/>
                                <TextBlock Text="Camera" FontSize="10.5" Foreground="#FFFFFF"/>
                            </StackPanel>
                            <TextBlock Text="Ask (Default)" FontSize="9.5" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE720;" FontSize="10" Foreground="#CBD5E1" Margin="0,0,6,0"/>
                                <TextBlock Text="Microphone" FontSize="10.5" Foreground="#FFFFFF"/>
                            </StackPanel>
                            <TextBlock Text="Ask (Default)" FontSize="9.5" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE707;" FontSize="10" Foreground="#CBD5E1" Margin="0,0,6,0"/>
                                <TextBlock Text="Location" FontSize="10.5" Foreground="#FFFFFF"/>
                            </StackPanel>
                            <TextBlock Text="Ask (Default)" FontSize="9.5" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Height="1" Background="#18FFFFFF" Margin="0,0,0,10"/>

                        <!-- Clear site data action -->
                        <Button Style="{StaticResource SecondaryButton}"
                                Click="ClearSiteData_Click"
                                HorizontalAlignment="Stretch"
                                Padding="8,5">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE74D;" FontSize="10" Margin="0,0,6,0"/>
                                <TextBlock Text="Clear Cookies and Site Data" FontSize="10.5"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Zoom Flyout Popup -->
            <Popup x:Name="ZoomPopup"
                   PlacementTarget="{Binding ElementName=ZoomIndicatorButton}"
                   Placement="Bottom"
                   HorizontalOffset="-40"
                   VerticalOffset="8"
                   AllowsTransparency="True"
                   StaysOpen="False"
                   PopupAnimation="Fade">
                <Border Width="160"
                        Background="#F414141A"
                        BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.75"/>
                    </Border.Effect>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="26"/>
                        </Grid.ColumnDefinitions>

                        <!-- Zoom Out Button -->
                        <Button Grid.Column="0"
                                Style="{StaticResource IconButton}"
                                ToolTip="Zoom Out (Ctrl+-)"
                                Click="ZoomOutPopup_Click"
                                Width="24" Height="24">
                            <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE738;" FontSize="10" Foreground="#FFFFFF"/>
                        </Button>

                        <!-- Reset Zoom Button / Percentage -->
                        <Button Grid.Column="1"
                                Style="{StaticResource IconButton}"
                                ToolTip="Reset Zoom (Ctrl+0)"
                                Click="ResetZoomPopup_Click"
                                Height="24"
                                Margin="2,0">
                            <TextBlock x:Name="ZoomPopupPercentageText"
                                       Text="100%"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF"/>
                        </Button>

                        <!-- Zoom In Button -->
                        <Button Grid.Column="2"
                                Style="{StaticResource IconButton}"
                                ToolTip="Zoom In (Ctrl++)"
                                Click="ZoomInPopup_Click"
                                Width="24" Height="24">
                            <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE710;" FontSize="10" Foreground="#FFFFFF"/>
                        </Button>
                    </Grid>
                </Border>
            </Popup>
        </Grid>

        <!-- ==================== RIGHT SIDEBAR (AGENTS PANEL) ==================== -->
        <Border x:Name="AgentsBorder"
                Grid.Column="2"
                Width="320"
                ClipToBounds="True"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Top Window Controls & New Session (Height 42) -->
                    <RowDefinition Height="42"/>
                    <!-- Agents List & Chat Area -->
                    <RowDefinition Height="*"/>
                    <!-- Bottom Composer Input Bar -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Sidebar Header: Brand & New Session Button (Reserved 172px on right for Caption Buttons & Toggle) -->
                <Grid Grid.Row="0"
                      Height="42"
                      Margin="8,0,172,0"
                      VerticalAlignment="Center"
                      Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Brand (Draggable space) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Style="{StaticResource FluentIcon}" Text="&#xF4A5;" FontSize="12.5" Margin="0,0,5,0" Foreground="#FFFFFF"/>
                        <TextBlock Text="AGENTS"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Center Draggable Area -->
                    <Border Grid.Column="1" Background="Transparent"/>

                    <!-- New Agent Session Button -->
                    <Button Grid.Column="2"
                            Style="{StaticResource IconButton}"
                            ToolTip="New Agent Session"
                            Click="NewAgentChat_Click"
                            Width="26" Height="26"
                            Margin="0,0,4,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE710;" FontSize="11" Foreground="#FFFFFF"/>
                    </Button>
                </Grid>

                <!-- Middle Content: Suggestion Chips & Message Feed -->
                <Grid Grid.Row="1" Margin="6,0,6,4">
                    <Grid.RowDefinitions>
                        <!-- Capability Suggestion Chips -->
                        <RowDefinition Height="Auto"/>
                        <!-- Conversation Feed -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Quick Capability Suggestion Chips -->
                    <WrapPanel Grid.Row="0" Margin="0,0,0,6" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource IconButton}"
                                Click="AgentChip_Click"
                                Tag="Summarize current page"
                                Margin="0,0,4,4"
                                Padding="0">
                            <Border Background="#10FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="5" Padding="7,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE890;" FontSize="9.5" Foreground="#FFFFFF" Margin="0,0,4,0"/>
                                    <TextBlock Text="Summarize" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </Button>
                        <Button Style="{StaticResource IconButton}"
                                Click="AgentChip_Click"
                                Tag="Explain this webpage"
                                Margin="0,0,4,4"
                                Padding="0">
                            <Border Background="#10FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="5" Padding="7,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE8BD;" FontSize="9.5" Foreground="#FFFFFF" Margin="0,0,4,0"/>
                                    <TextBlock Text="Explain" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </Button>
                        <Button Style="{StaticResource IconButton}"
                                Click="AgentChip_Click"
                                Tag="Find key takeaways"
                                Margin="0,0,0,4"
                                Padding="0">
                            <Border Background="#10FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="5" Padding="7,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE721;" FontSize="9.5" Foreground="#FFFFFF" Margin="0,0,4,0"/>
                                    <TextBlock Text="Takeaways" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </Button>
                    </WrapPanel>

                    <!-- Message Feed -->
                    <ScrollViewer x:Name="AgentMessagesScrollViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,4,0"
                                  WindowChrome.IsHitTestVisibleInChrome="True">
                        <ItemsControl x:Name="AgentMessagesItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <!-- User Message Bubble -->
                                        <Border CornerRadius="8"
                                                Padding="8,6"
                                                MaxWidth="270"
                                                HorizontalAlignment="Right"
                                                Background="#1CFFFFFF"
                                                BorderBrush="#25FFFFFF"
                                                BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Content}"
                                                           FontSize="11.5"
                                                           Foreground="#FFFFFF"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding FormattedTime}"
                                                           FontSize="8.5"
                                                           Foreground="#60FFFFFF"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Agent Message Bubble -->
                                        <Border CornerRadius="8"
                                                Padding="8,6"
                                                MaxWidth="280"
                                                HorizontalAlignment="Left"
                                                Background="#0EFFFFFF"
                                                BorderBrush="#14FFFFFF"
                                                BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAgent}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <TextBlock Style="{StaticResource FluentIcon}" Text="&#xF4A5;" FontSize="9.5" Foreground="#FFFFFF" Margin="0,0,4,0"/>
                                                    <TextBlock Text="Agent" FontSize="9.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Content}"
                                                           FontSize="11.5"
                                                           Foreground="#E2E8F0"
                                                           TextWrapping="Wrap"
                                                           LineHeight="16"/>
                                                <TextBlock Text="{Binding FormattedTime}"
                                                           FontSize="8.5"
                                                           Foreground="#50FFFFFF"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Bottom Input Composer Bar with Integrated Agent Dropdown -->
                <Border Grid.Row="2"
                        Margin="6,2,6,6"
                        Background="#0DFFFFFF"
                        BorderBrush="#16FFFFFF"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="7,6"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Input Text Area -->
                            <RowDefinition Height="Auto"/>
                            <!-- Action Bar: Agent Dropdown & Send -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Input TextBox & Placeholder -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <TextBox x:Name="AgentInputTextBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     CaretBrush="#FFFFFF"
                                     FontSize="11.5"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="20"
                                     MaxHeight="70"
                                     VerticalScrollBarVisibility="Auto"
                                     KeyDown="AgentInputTextBox_KeyDown"
                                     TextChanged="AgentInputTextBox_TextChanged"/>

                            <TextBlock x:Name="AgentPlaceholderText"
                                       Text="Ask agent or summarize..."
                                       Foreground="#40FFFFFF"
                                       FontSize="11.5"
                                       VerticalAlignment="Top"
                                       IsHitTestVisible="False"
                                       Margin="2,1,0,0"/>
                        </Grid>

                        <!-- Bottom Action Bar -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <!-- Agent Picker Dropdown Button -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- Spacer -->
                                <ColumnDefinition Width="*"/>
                                <!-- Send Button -->
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Agent Selector Dropdown Pill -->
                            <Button x:Name="AgentPickerButton"
                                    Grid.Column="0"
                                    Style="{StaticResource IconButton}"
                                    ToolTip="Choose agent persona"
                                    Click="AgentPickerButton_Click"
                                    Height="22"
                                    Padding="6,0"
                                    Background="#14FFFFFF"
                                    BorderBrush="#1AFFFFFF"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="SelectedAgentIcon"
                                               Style="{StaticResource FluentIcon}"
                                               Text="&#xF4A5;"
                                               FontSize="10"
                                               Foreground="#FFFFFF"
                                               Margin="0,0,4,0"/>
                                    <TextBlock x:Name="SelectedAgentText"
                                               Text="Page Copilot"
                                               FontSize="10"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,4,0"/>
                                    <TextBlock Style="{StaticResource FluentIcon}"
                                               Text="&#xE70D;"
                                               FontSize="7"
                                               Foreground="#FFFFFF"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Send Message Button -->
                            <Button Grid.Column="2"
                                    Style="{StaticResource IconButton}"
                                    ToolTip="Send message (Enter)"
                                    Click="SendAgentMessage_Click"
                                    Width="24" Height="22"
                                    Background="#14FFFFFF"
                                    BorderBrush="#1AFFFFFF"
                                    BorderThickness="1">
                                <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE724;" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Button>
                        </Grid>

                        <!-- Agent Persona Dropdown Popup -->
                        <Popup x:Name="AgentPickerPopup"
                               PlacementTarget="{Binding ElementName=AgentPickerButton}"
                               Placement="Top"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               VerticalOffset="-5"
                               PopupAnimation="Fade">
                            <Border Background="#202024"
                                    BorderBrush="#25FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="4"
                                    Width="210"
                                    SnapsToDevicePixels="True">
                                <StackPanel>
                                    <TextBlock Text="SELECT AGENT"
                                               FontSize="8.5"
                                               FontWeight="SemiBold"
                                               Foreground="#60FFFFFF"
                                               Margin="6,3,6,4"/>
                                    <ItemsControl x:Name="AgentPickerItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="PickerItemBorder"
                                                        CornerRadius="5"
                                                        Padding="6,4"
                                                        Margin="0,1"
                                                        Background="Transparent"
                                                        Cursor="Hand"
                                                        MouseLeftButtonDown="AgentPickerItem_Click">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="18"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Style="{StaticResource FluentIcon}"
                                                                   Text="{Binding Icon}"
                                                                   FontSize="11"
                                                                   Foreground="#FFFFFF"
                                                                   VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,4,0">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="10.5"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding Status}"
                                                                       FontSize="8.5"
                                                                       Foreground="#CBD5E1"
                                                                       Margin="0,1,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="&#xE73E;"
                                                                   FontSize="9"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource FluentIcon}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="PickerItemBorder" Property="Background" Value="#15FFFFFF"/>
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>

                <!-- Right Sidebar Resize Splitter (Left Edge) -->
                <Border x:Name="RightSidebarSplitter"
                        Grid.Row="0"
                        Grid.RowSpan="3"
                        Width="7"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        Cursor="SizeWE"
                        Background="Transparent"
                        Panel.ZIndex="100"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        PreviewMouseLeftButtonDown="RightSidebarSplitter_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="RightSidebarSplitter_PreviewMouseMove"
                        PreviewMouseLeftButtonUp="RightSidebarSplitter_PreviewMouseLeftButtonUp"
                        LostMouseCapture="Splitter_LostMouseCapture">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#30FFFFFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>
        </Border>

        <!-- Flush Native Windows 11 Caption Controls & Right Sidebar Toggle (Top Right Overlay) -->
        <StackPanel Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Height="42"
                    Panel.ZIndex="300"
                    WindowChrome.IsHitTestVisibleInChrome="True">
            <!-- Dedicated Right Sidebar (Agents Panel) Toggle Button -->
            <Button x:Name="RightSidebarToggleButton"
                    Style="{StaticResource IconButton}"
                    ToolTip="Collapse Agents Panel (Ctrl+J)"
                    Click="ToggleAgentsPanel_Click"
                    Width="28" Height="28"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center">
                <TextBlock x:Name="RightSidebarToggleIcon"
                           Style="{StaticResource FluentIcon}"
                           Text="&#xF4A5;"
                           FontSize="12.5"
                           Foreground="#FFFFFF"/>
            </Button>

            <!-- Minimize -->
            <Button Style="{StaticResource WindowsCaptionButton}"
                    ToolTip="Minimize"
                    Click="MinimizeButton_Click">
                <Path Data="M 0,0 L 10,0"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
            </Button>

            <!-- Maximize / Restore -->
            <Button x:Name="MaximizeBtn"
                    Style="{StaticResource WindowsCaptionButton}"
                    ToolTip="Maximize / Restore"
                    Click="MaximizeButton_Click">
                <Path x:Name="MaximizePath"
                      Data="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
            </Button>

            <!-- Close -->
            <Button Style="{StaticResource WindowsCloseButton}"
                    ToolTip="Close (Alt+F4)"
                    Click="CloseButton_Click">
                <Path Data="M 0,0 L 9.5,9.5 M 9.5,0 L 0,9.5"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
