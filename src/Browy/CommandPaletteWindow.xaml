<Window x:Class="Browy.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Command Palette"
        Width="620"
        Height="420"
        WindowStyle="None"
        Background="Transparent"
        Foreground="#FFFFFF"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized"
        Deactivated="Window_Deactivated"
        KeyDown="Window_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1"
                      CaptionHeight="0"
                      CornerRadius="0"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Windows 11 Fluent Icon Font Family and Style -->
        <FontFamily x:Key="FluentIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="FluentIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FluentIcons}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Command List Item Container Style -->
        <Style x:Key="CommandItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,6"
                                Margin="4,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#20FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#30FFFFFF"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#45FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Entire Window Surface is Acrylic (No background fills, 1px subtle Fluent border) -->
    <Border BorderBrush="#35FFFFFF"
            BorderThickness="1"
            Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Search Input Bar -->
                <RowDefinition Height="46"/>
                <!-- Filtered Command Results List -->
                <RowDefinition Height="*"/>
                <!-- Footer Navigation Hints -->
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <!-- Search Input Row -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="34"/>
                </Grid.ColumnDefinitions>

                <!-- Search Fluent Icon -->
                <TextBlock Grid.Column="0"
                           Style="{StaticResource FluentIcon}"
                           Text="&#xE721;"
                           FontSize="13"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <!-- Search Input Box -->
                <TextBox x:Name="SearchTextBox"
                         Grid.Column="1"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#FFFFFF"
                         CaretBrush="#FFFFFF"
                         FontSize="13"
                         VerticalAlignment="Center"
                         TextChanged="SearchTextBox_TextChanged"
                         PreviewKeyDown="SearchTextBox_PreviewKeyDown"/>

                <!-- Search Placeholder -->
                <TextBlock x:Name="SearchPlaceholderText"
                           Grid.Column="1"
                           Text="Type a command or search options..."
                           Foreground="#55FFFFFF"
                           FontSize="13"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>

                <!-- Clear Search Button -->
                <Button x:Name="ClearSearchBtn"
                        Grid.Column="2"
                        Width="22" Height="22"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="ClearSearchBtn_Click"
                        Visibility="Collapsed">
                    <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE711;" FontSize="9" Foreground="#A0FFFFFF"/>
                </Button>

                <!-- Bottom Divider Line -->
                <Border Grid.ColumnSpan="3"
                        Height="1"
                        Background="#25FFFFFF"
                        VerticalAlignment="Bottom"/>
            </Grid>

            <!-- Command List Results -->
            <Grid Grid.Row="1">
                <ListBox x:Name="CommandsListBox"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemContainerStyle="{StaticResource CommandItemContainerStyle}"
                         SelectionMode="Single"
                         MouseDoubleClick="CommandsListBox_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- Icon -->
                                    <ColumnDefinition Width="28"/>
                                    <!-- Title & Category & Description -->
                                    <ColumnDefinition Width="*"/>
                                    <!-- Shortcut Badge -->
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Command Icon -->
                                <Border Grid.Column="0"
                                        Width="22" Height="22"
                                        Background="#20FFFFFF"
                                        CornerRadius="5"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left">
                                    <TextBlock Style="{StaticResource FluentIcon}"
                                               Text="{Binding Icon}"
                                               FontSize="11"
                                               Foreground="#FFFFFF"/>
                                </Border>

                                <!-- Title & Subtitle Info -->
                                <StackPanel Grid.Column="1" Margin="6,0,8,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFFFFF"/>
                                        <Border Background="#20FFFFFF"
                                                CornerRadius="3"
                                                Padding="4,1"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Category}"
                                                       FontSize="9"
                                                       Foreground="#E2E8F0"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="10"
                                               Foreground="#CBD5E1"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,1,0,0"/>
                                </StackPanel>

                                <!-- Shortcut Key Badge -->
                                <Border Grid.Column="2"
                                        Background="#25FFFFFF"
                                        BorderBrush="#35FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Shortcut}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Shortcut}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFF"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty State Text -->
                <TextBlock x:Name="EmptyResultsText"
                           Text="No commands found matching your search"
                           FontSize="12"
                           Foreground="#80FFFFFF"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>

            <!-- Footer Command Hints -->
            <Border Grid.Row="2"
                    Background="#15FFFFFF"
                    BorderBrush="#25FFFFFF"
                    BorderThickness="0,1,0,0"
                    Padding="12,0">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="↑↓ Navigate" FontSize="9.5" Foreground="#90FFFFFF" Margin="0,0,12,0"/>
                        <TextBlock Text="↵ Execute" FontSize="9.5" Foreground="#90FFFFFF" Margin="0,0,12,0"/>
                        <TextBlock Text="Esc Dismiss" FontSize="9.5" Foreground="#90FFFFFF"/>
                    </StackPanel>
                    <TextBlock Text="Browy Actions"
                               FontSize="9"
                               Foreground="#80FFFFFF"
                               HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
